{
  "name": "CRM SaaS DevContainer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:18",
  "postCreateCommand": "bash scripts/setup_codespace.sh",
  "forwardPorts": [3000, 4000],
  "portsAttributes": {
    "3000": {
      "label": "Frontend"
    },
    "4000": {
      "label": "Backend"
    }
  }
}
